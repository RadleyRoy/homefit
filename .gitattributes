# Normalise to LF in the repository. This matters for gradlew specifically: a CRLF shebang
# line makes it fail with "bad interpreter" when built from Git Bash or WSL.
* text=auto eol=lf

*.bat text eol=crlf
gradlew text eol=lf

*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.keystore binary
*.jks binary
