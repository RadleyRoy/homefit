<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules. Everything the app owns is personal history the user would want
  back on a new phone, so the database and settings go to Google's encrypted cloud backup and
  device transfer. Shared preferences are not included, which deliberately leaves out the
  coach API key: its Tink keyset is bound to this device's Keystore and couldn't be decrypted
  anywhere else.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
